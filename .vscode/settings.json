{
  "files.associations": {
    "*.rpy": "renpy",
    "*.rpym": "renpy"
  },
  "files.exclude": {
    "**/*.rpyc": true,
    "**/*.rpymc": true,
    "**/*.rpa": true,
    "**/cache": true,
    "**/saves": true
  },
  "search.exclude": {
    "**/*.rpyc": true,
    "**/cache": true,
    "**/saves": true,
    "**/dist": true
  },
  "[renpy]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  }
}
